diff --git a/daemon/stateless_ipc.h b/daemon/stateless_ipc.h
index 339ce53..9e0b2e6 100644
--- a/daemon/stateless_ipc.h
+++ b/daemon/stateless_ipc.h
@@ -2,7 +2,12 @@
 #define NETATALK_CLIENT_DAEMON_STATELESS_IPC_H
 
 #include <limits.h>
+#include <pwd.h>
 #include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
 
 #include "netatalk-client/afpsl.h"
 #include "lib/afp_protocol.h"
@@ -14,8 +19,24 @@
 #define AFPSL_IPC_PROTOCOL_MAJOR 3U
 #define AFPSL_IPC_PROTOCOL_MINOR 0U
 
-/* Unix socket shared by afpsld and libafpsl. */
-#define AFPSL_IPC_SOCKET_PATH "/tmp/afp_sl"
+/* Unix socket shared by afpsld and libafpsl.
+ * Prefer AFPSL_SOCKET_PATH, else /tmp fallback. ClassicAFP's sandboxed appex
+ * sets AFPSL_TCP_PORT instead and reaches afpsld via the host TCP→Unix proxy. */
+#define AFPSL_IPC_SOCKET_PATH_FALLBACK "/tmp/classic548-afpsl"
+#define AFPSL_IPC_SOCKET_NAME "classic548-afpsl"
+/* Back-compat for any leftover references. */
+#define AFPSL_IPC_SOCKET_PATH AFPSL_IPC_SOCKET_PATH_FALLBACK
+
+static inline void afpsl_ipc_socket_path(char *buf, size_t buflen)
+{
+    const char *env = getenv("AFPSL_SOCKET_PATH");
+
+    if (env != NULL && env[0] != '\0') {
+        snprintf(buf, buflen, "%s", env);
+        return;
+    }
+    snprintf(buf, buflen, "%s", AFPSL_IPC_SOCKET_PATH_FALLBACK);
+}
 
