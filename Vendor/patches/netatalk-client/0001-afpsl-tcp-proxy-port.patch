@@ -386,6 +388,7 @@ int daemon_connect(unsigned int daemon_uid)
     struct sockaddr_un servaddr;
     int retries = 50;
     int ret;
+    const char *tcp_port_env;
 
     /* Check if we already have a valid connection */
     if (connection.fd >= 0) {
@@ -394,6 +397,52 @@ int daemon_connect(unsigned int daemon_uid)
         return 0;
     }
 
+    (void)daemon_uid;
+
+    /*
+     * ClassicAFP FSKit appex: Unix connect to /tmp is EPERM under sandbox.
+     * Host runs a TCP→Unix proxy; set AFPSL_TCP_PORT to use loopback instead.
+     * Do not auto-spawn afpsld when using TCP — the host owns the daemon.
+     */
+    tcp_port_env = getenv("AFPSL_TCP_PORT");
+    if (tcp_port_env != NULL && tcp_port_env[0] != '\0') {
+        char *end = NULL;
+        long port = strtol(tcp_port_env, &end, 10);
+        struct sockaddr_in tcpaddr;
+
+        if (end == tcp_port_env || port <= 0 || port > 65535) {
+            stateless_log_message(LOG_ERR, "Invalid AFPSL_TCP_PORT");
+            errno = EINVAL;
+            return -1;
+        }
+
+        if ((sock = socket(AF_INET, SOCK_STREAM, 0)) < 0) {
+            stateless_log_errno(LOG_ERR, "Could not create TCP socket", errno);
+            return -1;
+        }
+
+#ifdef SO_NOSIGPIPE
+        {
+            int on = 1;
+            setsockopt(sock, SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on));
+        }
+#endif
+        memset(&tcpaddr, 0, sizeof(tcpaddr));
+        tcpaddr.sin_family = AF_INET;
+        tcpaddr.sin_port = htons((uint16_t)port);
+        tcpaddr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        ret = connect(sock, (struct sockaddr *)&tcpaddr, sizeof(tcpaddr));
+        if (ret < 0) {
+            int saved = errno;
+            stateless_log_errno(LOG_ERR, "TCP connect to afpsld proxy failed", saved);
+            close(sock);
+            errno = saved;
+            return -1;
+        }
+        stateless_log_message(LOG_DEBUG, "Connected to afpsld via TCP proxy");
+        goto done;
+    }
+
     if ((sock = socket(AF_UNIX, SOCK_STREAM, 0)) < 0) {
         stateless_log_errno(LOG_ERR, "Could not create socket", errno);
         return -1;
@@ -407,8 +456,7 @@ int daemon_connect(unsigned int daemon_uid)
 #endif
     memset(&servaddr, 0, sizeof(servaddr));
     servaddr.sun_family = AF_UNIX;
-    snprintf(servaddr.sun_path, sizeof(servaddr.sun_path), "%s-%d",
-             AFPSL_IPC_SOCKET_PATH, daemon_uid);
+    afpsl_ipc_socket_path(servaddr.sun_path, sizeof(servaddr.sun_path));
     /* Try to connect first */
     ret = connect(sock, (struct sockaddr *) &servaddr, sizeof(servaddr));
 
@@ -2828,7 +2876,17 @@ int afp_sl_changepw(struct afpc_url *url, const char *old_password,
 static int ensure_daemon_connection(void)
 {
     int ret = daemon_connect(geteuid());
-    return ret == 0 ? 0 : ret;
+
+    if (ret == 0) {
+        return 0;
+    }
+    /* daemon_connect() historically returns bare -1 with errno set. */
+    if (ret == -1) {
+        int saved = errno;
+
+        return saved > 0 ? -saved : -ECONNREFUSED;
+    }
+    return ret;
 }
 
